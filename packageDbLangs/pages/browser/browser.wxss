.search-row { display: flex; align-items: center; margin-bottom: 14rpx; }
.conv-input {
  flex: 1;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  color: #fff;
  margin-right: 16rpx;
}
.cat-list { display: flex; flex-wrap: wrap; margin-top: 8rpx; }
.cat-chip {
  background: rgba(255,255,255,0.07);
  border-radius: 20rpx;
  padding: 10rpx 20rpx;
  margin: 0 12rpx 12rpx 0;
  font-size: 26rpx;
  color: #98a2c3;
}
.cat-on { background: linear-gradient(135deg, #6366f1, #22d3ee); color: #fff; font-weight: bold; }
.row { padding: 20rpx 0; border-bottom: 1px solid rgba(255,255,255,0.06); }
.row:last-child { border-bottom: none; }
.row-name { font-size: 32rpx; font-weight: bold; color: #ffd9a0; font-family: monospace; }
.row-sub { font-size: 26rpx; color: #98a2c3; margin-top: 8rpx; line-height: 1.6;
  overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.row-meta { font-size: 24rpx; color: #a97c50; margin-top: 6rpx; }
.hl { color: #7ef0c8; background: rgba(126,240,200,0.15); border-radius: 4rpx; }
.center { text-align: center; padding: 24rpx; }
.code {
  background: #080b14;
  border: 1px solid #232c4d;
  border-radius: 10rpx;
  padding: 16rpx 18rpx;
  font-family: monospace;
  font-size: 26rpx;
  line-height: 1.7;
  color: #7ef0c8;
  white-space: pre-wrap;
  word-break: break-all;
  margin: 10rpx 0;
}
.kv-row { display: flex; padding: 12rpx 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
.kv-row:last-child { border-bottom: none; }
.kv-k { color: #ffd166; font-family: monospace; font-size: 28rpx; min-width: 220rpx; }
.kv-d { color: #e9edf8; font-size: 28rpx; flex: 1; line-height: 1.6; }
