<view class="card">
  <view class="card-title">📊 知识库统计</view>
  <view class="stat-grid" wx:if="{{stats}}">
    <view class="stat"><view class="stat-n">{{stats.records}}</view><view class="stat-l">总条目</view></view>
    <view class="stat"><view class="stat-n">{{stats.keywords}}</view><view class="stat-l">语言关键字</view></view>
    <view class="stat"><view class="stat-n">{{stats.examples}}</view><view class="stat-l">示例</view></view>
    <view class="stat"><view class="stat-n">{{stats.params}}</view><view class="stat-l">参数</view></view>
  </view>
  <view class="muted">全部离线可用 · 数据来自微软官方文档与火星极客精选</view>
</view>

<view class="card">
  <view class="card-title">⚡ 精选速查</view>
  <view class="tabs">
    <view class="tab {{featTab==='dos' ? 'tab-on' : ''}}" data-tab="dos" bindtap="onFeatTab">DOS / CMD</view>
    <view class="tab {{featTab==='ps' ? 'tab-on' : ''}}" data-tab="ps" bindtap="onFeatTab">PowerShell</view>
  </view>
  <block wx:for="{{featList}}" wx:key="id">
    <view class="feat-item">
      <view class="feat-head" data-id="{{item.id}}" bindtap="onFeatToggle">
        <text class="feat-name">{{item.n}}</text>
        <text class="feat-desc">{{item.d}}</text>
        <text class="feat-arrow">{{expandedId===item.id ? '▾' : '▸'}}</text>
      </view>
      <view class="feat-body" wx:if="{{expandedId===item.id}}">
        <view class="feat-sec" wx:if="{{item.s}}">
          <view class="feat-k">语法</view>
          <view class="feat-code">{{item.s}}</view>
        </view>
        <view class="feat-sec" wx:if="{{item.p}}">
          <view class="feat-k">参数</view>
          <block wx:for="{{item.p}}" wx:for-item="pm" wx:key="n">
            <view class="feat-p"><text class="feat-pn">{{pm.n}}</text><text class="feat-pd">{{pm.d}}</text></view>
          </block>
        </view>
        <view class="feat-sec" wx:if="{{item.e}}">
          <view class="feat-k">示例</view>
          <block wx:for="{{item.e}}" wx:for-item="ex" wx:key="index">
            <view class="feat-exd" wx:if="{{ex.d}}">{{ex.d}}</view>
            <view class="feat-code">{{ex.c}}</view>
          </block>
        </view>
      </view>
    </view>
  </block>
  <view class="muted">点条目展开语法 / 参数 / 示例 · 完整 3000+ 条目见下方全库</view>
</view>

<block wx:for="{{dbs}}" wx:for-item="db" wx:key="id">
  <view class="card">
    <view class="db-head" data-db="{{db.id}}" bindtap="onDbTap">
      <view class="db-icon">{{db.icon}}</view>
      <view class="db-info">
        <view class="db-name">{{db.name}}</view>
        <view class="muted">{{db.total}} 条 · {{db.categories.length}} 个分类</view>
      </view>
      <view class="db-go">›</view>
    </view>
    <view class="search-row">
      <input class="conv-input" placeholder="搜索{{db.name}}…" data-db="{{db.id}}" bindinput="onQueryInput" />
      <view class="chip chip-on" data-db="{{db.id}}" bindtap="onSearch">搜索</view>
    </view>
    <view class="cat-list">
      <block wx:for="{{db.categories}}" wx:for-item="cat" wx:key="name">
        <view class="cat-chip" data-db="{{db.id}}" data-cat="{{cat.name}}" bindtap="onCatTap">{{cat.name}} {{cat.count}}</view>
      </block>
    </view>
  </view>
</block>

<view class="card">
  <view class="card-title">🔢 进制转换器</view>
  <view class="conv-row">
    <input class="conv-input" value="{{convInput}}" bindinput="onConvInput" placeholder="输入数字" />
    <picker mode="selector" range="{{bases}}" value="{{baseIdx}}" bindchange="onPickBase">
      <view class="chip chip-on">{{convBase}}进制 ▾</view>
    </picker>
  </view>
  <block wx:if="{{convOut}}">
    <view class="kv-row"><view class="kv-k">二进制 BIN</view><view class="kv-d">{{convOut.b2}}</view></view>
    <view class="kv-row"><view class="kv-k">八进制 OCT</view><view class="kv-d">{{convOut.b8}}</view></view>
    <view class="kv-row"><view class="kv-k">十进制 DEC</view><view class="kv-d">{{convOut.b10}}</view></view>
    <view class="kv-row"><view class="kv-k">十六进制 HEX</view><view class="kv-d">{{convOut.b16}}</view></view>
  </block>
  <view class="muted" wx:else>输入的数字无法按 {{convBase}} 进制解析</view>
</view>

<view style="height:40rpx;"></view>
