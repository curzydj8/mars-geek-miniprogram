.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 30rpx;
}
.hero-logo { font-size: 110rpx; }
.hero-name {
  font-size: 56rpx;
  font-weight: bold;
  color: #ffd9a0;
  margin-top: 16rpx;
  letter-spacing: 12rpx;
}
.hero-sub { color: #a97c50; margin-top: 12rpx; font-size: 26rpx; }
.body-text { line-height: 1.8; }
